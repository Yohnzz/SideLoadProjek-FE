# ==============================================================================
# SIDELOAD ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# 1. SUPABASE CREDENTIALS
# Dapatkan dari: Dashboard Supabase (app.supabase.com) -> Masuk ke Project Anda -> Project Settings -> API
# Salin 'Project URL' ke VITE_SUPABASE_URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Salin 'Project API keys' bagian 'anon' 'public' ke VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-here

# 2. MIDTRANS PAYMENT GATEWAY
# Dapatkan dari: Dashboard Midtrans (dashboard.sandbox.midtrans.com) -> Settings -> Access Keys -> Client Key
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
VITE_MIDTRANS_IS_PRODUCTION=false
