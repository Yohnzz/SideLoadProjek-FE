# ==============================================================================
# SIDELOAD ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# 1. SUPABASE CREDENTIALS
# Dapatkan dari: Dashboard Supabase (app.supabase.com) -> Masuk ke Project Anda -> Project Settings -> API
# Salin 'Project URL' ke VITE_SUPABASE_URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Salin 'Project API keys' bagian 'anon' 'public' ke VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-here

# 2. MIDTRANS PAYMENT GATEWAY
# Dapatkan dari: Dashboard Midtrans (dashboard.sandbox.midtrans.com) -> Settings -> Access Keys -> Client Key
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
VITE_MIDTRANS_IS_PRODUCTION=false

# 3. BACKBLAZE B2 CLOUD STORAGE (S3-COMPATIBLE)
# Disimpan di Supabase Project Settings -> Edge Functions -> Secrets (atau .env lokal untuk pengujian)
# Dapatkan dari: Dashboard Backblaze (backblaze.com/b2) -> Application Keys
B2_APPLICATION_KEY_ID=004xxxxxxxxxxxx0000000001
B2_APPLICATION_KEY=K004xxxxxxxxxxxxxxxxxxxxxxxxxxxx
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_NAME=sideload-games-vault

# Opsional: Custom Domain Cloudflare CDN untuk WebGL & Aset Game Bebas Egress Bandwidth
VITE_B2_CDN_URL=https://cdn.sideload.id
